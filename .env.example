SEED=42
MODE=dev
DEFECT_RATE=0.02

POSTGRES_USER=voltia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voltiagrid
DATABASE_URL=postgresql+psycopg://voltia:change-me@localhost:5433/voltiagrid
# In AWS there is no DATABASE_URL: ECS injects DB_USER and DB_PASSWORD from Secrets Manager and the URL is
# built with sslmode=require (app/core/database_url.py). Same variables work locally if DATABASE_URL is empty:
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=voltiagrid
# DB_USER=voltia
# DB_PASSWORD=change-me
# DB_SSLMODE=disable

RABBITMQ_DEFAULT_USER=voltia
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://voltia:change-me@localhost:5672/%2F

SIM_SEED=42
SIM_METERS=0
SIM_TICK_SECONDS=10
SIM_START=2013-01-01T00:00:00Z
SIM_OUTAGE_METERS=0
SIM_OUTAGE_HOURS=24
# APIs (US-13). Use a long random value for JWT_SECRET, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
DEMO_CUSTOMER_PASSWORD=change-me
DEMO_INTERNAL_PASSWORD=change-me