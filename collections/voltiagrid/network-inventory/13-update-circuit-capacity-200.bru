meta {
  name: Update circuit capacity 200
  type: http
  seq: 13
}

patch {
  url: {{inventoryUrl}}/circuits/{{newCircuitCode}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{internalToken}}
}

body:json {
  {
    "capacity_kva": "1750.00"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("capacity is updated", function() {
    expect(res.getBody().capacity_kva).to.equal("1750.00");
  });
}
