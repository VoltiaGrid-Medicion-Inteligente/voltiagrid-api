              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "kVA, up to 6 digits and 2 decimals (NUMERIC(8,2))",
            "examples": [
              "250.00"
            ],
            "title": "Capacity Kva"
          }
        },
        "required": [
          "capacity_kva"
        ],
        "title": "CapacityUpdate",
        "type": "object"
      },
