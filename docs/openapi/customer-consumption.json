{
  "components": {
    "schemas": {
      "CircuitProfile": {
        "properties": {
          "code": {
            "examples": [
              "CT-000"
            ],
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CircuitProfile",
        "type": "object"
      },
      "DailyBandConsumption": {
        "properties": {
          "band_name": {
            "enum": [
              "peak",
              "intermediate",
              "off-peak"
            ],
            "title": "Band Name",
            "type": "string"
          },
          "cost": {
            "description": "energy_kwh x band price (F7)",
            "examples": [
              "1.0236"
            ],
            "title": "Cost",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "energy_kwh": {
            "examples": [
              "3.412"
            ],
            "title": "Energy Kwh",
            "type": "string"
          },
          "estimated_readings": {
            "description": "how many of them were estimated (RN-03)",
            "examples": [
              0
            ],
            "title": "Estimated Readings",
            "type": "integer"
          },
          "readings": {
            "description": "30-minute readings in the band that day",
            "examples": [
              8
            ],
            "title": "Readings",
            "type": "integer"
          }
        },
        "required": [
          "date",
          "band_name",
          "energy_kwh",
          "cost",
          "readings",
          "estimated_readings"
        ],
        "title": "DailyBandConsumption",
        "type": "object"
      },
      "DailyConsumptionResponse": {
        "properties": {
          "customer_code": {
            "examples": [
              "CU-MAC000002"
            ],
            "title": "Customer Code",
            "type": "string"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DailyBandConsumption"
            },
            "title": "Days",
            "type": "array"
          },
          "has_estimated_readings": {
            "title": "Has Estimated Readings",
            "type": "boolean"
          },
          "month": {
            "examples": [
              "2013-03"
            ],
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "customer_code",
          "month",
          "has_estimated_readings",
          "days"
        ],
        "title": "DailyConsumptionResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The one error body every API returns.",
        "properties": {
          "detail": {
            "examples": [
              "Transformer 'TR-99999' not found"
            ],
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only on 422: one item per invalid field",
            "title": "Errors"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventParticipation": {
        "properties": {
          "actual_kwh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "6.0000"
            ],
            "title": "Actual Kwh"
          },
          "baseline_kwh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "average of the same window over the last 5 working days without an event (RN-09); null without 5 days",
            "examples": [
              "7.2000"
            ],
            "title": "Baseline Kwh"
          },
          "end": {
            "description": "event window end (UTC), 3 hours at most",
            "examples": [
              "2013-07-22T22:00:00"
            ],
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "event_date": {
            "format": "date",
            "title": "Event Date",
            "type": "string"
          },
          "event_id": {
            "examples": [
              "DR-CT-000-20130722"
            ],
            "title": "Event Id",
            "type": "string"
          },
          "incentive_amount": {
            "examples": [
              "0.36"
            ],
            "title": "Incentive Amount",
            "type": "string"
          },
          "incentive_paid": {
            "description": "savings of 10% or more (RN-09)",
            "title": "Incentive Paid",
            "type": "boolean"
          },
          "savings_kwh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "1.2000"
            ],
            "title": "Savings Kwh"
          },
          "savings_pct": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "savings / baseline",
            "examples": [
              "0.1667"
            ],
            "title": "Savings Pct"
          },
          "start": {
            "description": "event window start (UTC)",
            "examples": [
              "2013-07-22T19:00:00"
            ],
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "event_date",
          "start",
          "end",
          "baseline_kwh",
          "actual_kwh",
          "savings_kwh",
          "savings_pct",
          "incentive_paid",
          "incentive_amount"
        ],
        "title": "EventParticipation",
        "type": "object"
      },
      "EventsResponse": {
        "properties": {
          "customer_code": {
            "examples": [
              "CU-MAC000002"
            ],
            "title": "Customer Code",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventParticipation"
            },
            "title": "Events",
            "type": "array"
          },
          "incentives_total": {
            "examples": [
              "0.36"
            ],
            "title": "Incentives Total",
            "type": "string"
          },
          "month": {
            "examples": [
              "2013-07"
            ],
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "customer_code",
          "month",
          "events",
          "incentives_total"
        ],
        "title": "EventsResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "examples": [
              "acorn_grouped"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be 'Affluent', 'Comfortable', 'Adversity' or 'Unknown'"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "IntervalConsumption": {
        "properties": {
          "band_name": {
            "enum": [
              "peak",
              "intermediate",
              "off-peak"
            ],
            "title": "Band Name",
            "type": "string"
          },
          "energy_kwh": {
            "examples": [
              "0.412"
            ],
            "title": "Energy Kwh",
            "type": "string"
          },
          "estimated": {
            "description": "true when a meter's reading in this half hour was estimated (RN-03)",
            "title": "Estimated",
            "type": "boolean"
          },
          "start": {
            "description": "start of the half hour (UTC)",
            "examples": [
              "2013-03-01T00:00:00Z"
            ],
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "band_name",
          "energy_kwh",
          "estimated"
        ],
        "title": "IntervalConsumption",
        "type": "object"
      },
      "IntervalsResponse": {
        "properties": {
          "customer_code": {
            "examples": [
              "CU-MAC000002"
            ],
            "title": "Customer Code",
            "type": "string"
          },
          "date": {
            "examples": [
              "2013-03-01"
            ],
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "intervals": {
            "description": "48 half hours of the day, in order",
            "items": {
              "$ref": "#/components/schemas/IntervalConsumption"
            },
            "title": "Intervals",
            "type": "array"
          }
        },
        "required": [
          "customer_code",
          "date",
          "intervals"
        ],
        "title": "IntervalsResponse",
        "type": "object"
      },
      "MeterProfile": {
        "properties": {
          "circuit": {
            "$ref": "#/components/schemas/CircuitProfile"
          },
          "lclid": {
            "examples": [
              "MAC000002"
            ],
            "title": "Lclid",
            "type": "string"
          },
          "transformer": {
            "$ref": "#/components/schemas/TransformerProfile"
          }
        },
        "required": [
          "lclid",
          "transformer",
          "circuit"
        ],
        "title": "MeterProfile",
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "customer_code": {
            "examples": [
              "CU-MAC000002"
            ],
            "title": "Customer Code",
            "type": "string"
          },
          "meters": {
            "items": {
              "$ref": "#/components/schemas/MeterProfile"
            },
            "title": "Meters",
            "type": "array"
          },
          "socioeconomic_group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ACORN group (acorn_grouped)",
            "examples": [
              "Comfortable"
            ],
            "title": "Socioeconomic Group"
          },
          "tariff_type": {
            "anyOf": [
              {
                "enum": [
                  "standard",
                  "dynamic"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "tariff of the latest contract; null without one",
            "title": "Tariff Type"
          }
        },
        "required": [
          "customer_code",
          "tariff_type",
          "socioeconomic_group",
          "meters"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "TokenRequest": {
        "properties": {
          "password": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "examples": [
              "CU-MAC000002"
            ],
            "maxLength": 30,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "TokenRequest",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "seconds",
            "examples": [
              3600
            ],
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "TransformerProfile": {
        "properties": {
          "capacity_kva": {
            "examples": [
              "100.00"
            ],
            "title": "Capacity Kva",
            "type": "string"
          },
          "code": {
            "examples": [
              "TR-00001"
            ],
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code",
          "capacity_kva"
        ],
        "title": "TransformerProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "JWT from POST /auth/token of the customer consumption API",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Daily consumption per tariff band and demand-response events of the authenticated customer (RF-06, RN-09, RN-11).",
    "title": "VoltiaGrid customer consumption API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/token": {
      "post": {
        "operationId": "login_auth_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Wrong username or password"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get a JWT for a customer or an internal user",
        "tags": [
          "auth"
        ]
      }
    },
    "/customers/{customer_code}/consumption/daily": {
      "get": {
        "operationId": "customer_daily_consumption_customers__customer_code__consumption_daily_get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_code",
            "required": true,
            "schema": {
              "examples": [
                "CU-MAC000002"
              ],
              "title": "Customer Code",
              "type": "string"
            }
          },
          {
            "description": "Month as YYYY-MM",
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "description": "Month as YYYY-MM",
              "examples": [
                "2013-03"
              ],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "title": "Month",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyConsumptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller is not allowed to read this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Daily consumption per band of one customer (internal users, or the customer itself)",
        "tags": [
          "consumption"
        ]
      }
    },
    "/customers/{customer_code}/events": {
      "get": {
        "operationId": "customer_events_customers__customer_code__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_code",
            "required": true,
            "schema": {
              "examples": [
                "CU-MAC000002"
              ],
              "title": "Customer Code",
              "type": "string"
            }
          },
          {
            "description": "Month as YYYY-MM",
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "description": "Month as YYYY-MM",
              "examples": [
                "2013-03"
              ],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "title": "Month",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller is not allowed to read this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Demand-response events of one customer in a month (internal users, or the customer itself)",
        "tags": [
          "demand response"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/me/consumption/daily": {
      "get": {
        "operationId": "my_daily_consumption_me_consumption_daily_get",
        "parameters": [
          {
            "description": "Month as YYYY-MM",
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "description": "Month as YYYY-MM",
              "examples": [
                "2013-03"
              ],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "title": "Month",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyConsumptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller is not allowed to read this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Daily consumption per band of the authenticated customer",
        "tags": [
          "consumption"
        ]
      }
    },
    "/me/consumption/intervals": {
      "get": {
        "operationId": "my_intervals_me_consumption_intervals_get",
        "parameters": [
          {
            "description": "Day as YYYY-MM-DD",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "Day as YYYY-MM-DD",
              "examples": [
                "2013-03-01"
              ],
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntervalsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid or expired token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The caller is not allowed to read this resource"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
